# Recusa Node ou npm fora das versões em "engines" (package.json). O npm precisa ser 11.16 ou mais novo:
# versões antigas ignorariam em silêncio as proteções abaixo.
engine-strict=true

# Cadeia de suprimentos (docs/03-seguranca.md, seção 3.14; decisão 0009).
# Só instala versões publicadas há pelo menos 3 dias: pacotes sequestrados costumam ser removidos rápido.
min-release-age=3
# Scripts de instalação (preinstall, install, postinstall) só rodam para pacotes aprovados no campo
# "allowScripts" do package.json; qualquer outro faz a instalação falhar. Para aprovar depois de revisar:
# npm approve-scripts <pacote>
strict-allow-scripts=true
# Nenhuma dependência vinda direto de repositórios git.
allow-git=none
