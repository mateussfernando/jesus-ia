# Recusa Node ou npm fora das versões em "engines" (package.json). O npm precisa ser 11.16 ou mais novo:
# versões antigas ignorariam as proteções abaixo (o npm 10 sem nenhum aviso).
engine-strict=true

# Cadeia de suprimentos (docs/03-seguranca.md, seção 3.14; decisão 0009).

# Ao escolher versões (npm install <pacote>, npm update, lockfile novo), só aceita versões publicadas há
# pelo menos 3 dias: pacotes sequestrados costumam ser removidos rápido. O que já está no package-lock.json
# é instalado como está, por isso o diff do lockfile é revisado no PR.
min-release-age=3

# Nenhum script de dependência roda na instalação (inclusive de dependências embutidas e compilação nativa
# implícita, que o allowScripts sozinho não pega). Pacote que precisa de script: veja "Comandos" no CLAUDE.md.
ignore-scripts=true
# Segunda barreira: quando um script for liberado à mão (npm rebuild <pacote> --ignore-scripts=false),
# só roda se o pacote estiver aprovado no campo "allowScripts" do package.json.
strict-allow-scripts=true

# Nenhuma dependência vinda direto de repositório git.
allow-git=none

# Os pacotes @jesus/* vêm sempre do próprio workspace. O escopo @jesus no registry público não é nosso:
# apontá-lo para um endereço que não existe impede que o npm baixe um pacote de lá por engano.
@jesus:registry=https://registry.invalid/
