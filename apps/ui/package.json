{
  "name": "@jesus/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Interface do Jesus em Next.js (decisão 0013): exportação estática que o Electron carrega; inclui a aba Cenários (laboratório do holograma) e a tela de entrada.",
  "scripts": {
    "dev": "node scripts/next.mjs dev --hostname 127.0.0.1 --port 5173",
    "build": "node scripts/next.mjs build && node scripts/csp.mjs out",
    "test": "vitest run",
    "typecheck": "node scripts/next.mjs typegen && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@jesus/auth": "*",
    "@jesus/core": "*",
    "@jesus/hologram": "*",
    "@jesus/models": "*",
    "next": "16.4.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "vitest": "^5.0.0"
  }
}
